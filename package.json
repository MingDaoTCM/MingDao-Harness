{
  "name": "mingdao-harness",
  "version": "0.1.67",
  "description": "MingDao Harness —— 开源智能体框架（Agent Harness）。零依赖、开箱即用，针对 DeepSeek-V4 系列优化，开放主流模型接入。",
  "type": "module",
  "bin": {
    "mingdao": "src/cli.js",
    "mdh": "src/cli.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "skills/",
    "assets/",
    "docs/",
    "install.sh",
    "install.ps1",
    "install.bat",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MingDaoTCM/MingDao-Harness.git"
  },
  "author": "MingDao-Harness Contributors",
  "bugs": {
    "url": "https://github.com/MingDaoTCM/MingDao-Harness/issues"
  },
  "homepage": "https://harness.mingdao.ai",
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "agent",
    "harness",
    "ai",
    "cli",
    "tui",
    "llm",
    "deepseek",
    "coding-agent",
    "mingdao"
  ],
  "license": "MIT",
  "scripts": {
    "start": "node src/cli.js",
    "test": "node test/smoke.js",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node test/smoke.js && node test/e2e-local.js && node test/e2e-schedule.js",
    "desktop": "npm --prefix desktop start",
    "desktop:dist": "node scripts/sync-versions.mjs && npm --prefix desktop run dist:dir",
    "desktop:sync": "node scripts/sync-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}

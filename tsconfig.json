{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/pricing.js",
    "src/tokenizer.js",
    "src/context.js",
    "src/titles.js",
    "src/routing.js",
    "src/cost-guard.js",
    "src/agent.js",
    "src/cli.js",
    "src/commands/*.js",
    "src/providers/index.js",
    "src/cachestats.js",
    "src/batch.js",
    "src/compact.js",
    "src/memory.js",
    "src/schedule.js",
    "src/tools/bash.js",
    "src/atomic-write.js"
  ]
}

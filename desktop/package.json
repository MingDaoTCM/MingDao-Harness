{
  "name": "mingdao-desktop",
  "version": "0.1.69",
  "private": true,
  "type": "module",
  "main": "main.js",
  "description": "MingDao Harness 桌面版（Electron 薄壳，内置 WebUI）",
  "author": "MingDao-Harness Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:dir": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://harness.mingdao.ai"
}
